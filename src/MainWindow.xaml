<Window x:Class="AsterVPN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Aster VPN" Icon="Assets/aster.ico" Width="1220" Height="830" MinWidth="1040" MinHeight="700" Background="#0C0D0B" Foreground="#E9EBE3" FontFamily="Segoe UI" FontSize="14" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <!-- Keep the native window style for Windows minimize/restore animations; WindowChrome draws our custom frame. -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="ServerTemplate">
   <Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="86"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
    <Border Width="30" Height="30" CornerRadius="8" Background="#080A07" VerticalAlignment="Center"><Grid Width="22" Height="15"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Background="{Binding FlagTop}"/><Border Grid.Row="1" Background="{Binding FlagMiddle}"/><Border Grid.Row="2" Background="{Binding FlagBottom}"/></Grid></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProtocolDetail}" Foreground="{Binding ProtocolColor}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Latency}" Foreground="#929A83" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <TextBlock Grid.Column="3" Text="✓" Foreground="#C2DF51" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
  </DataTemplate>
  <Style x:Key="ServerItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E9EBE3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1B1E15"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#252C18"/><Setter TargetName="Row" Property="BorderBrush" Value="#667B2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Background="#10110F"><TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="11"><Run Text="ASTER" Foreground="#C2DF51" FontWeight="Bold"/><Run x:Name="HeaderVersion" Foreground="#666D5C"/></TextBlock><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Width="43" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="MinimizeClick"/><Button Content="□" Width="43" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="MaximizeClick"/><Button Content="×" FontSize="20" Width="43" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="CloseClick"/></StackPanel></Grid>
  <ProgressBar x:Name="OperationProgress" Height="3" VerticalAlignment="Bottom" Foreground="#C2DF51" Background="#252C18" BorderThickness="0" Visibility="Collapsed" Panel.ZIndex="5"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#141511" BorderBrush="#23261D" BorderThickness="0,0,1,0"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="22,29,0,26"><Image Source="Assets/aster.png" Width="34" Height="34"/><TextBlock Text="ASTER" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
     <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⌂   Главная" Tag="home" Checked="NavigationChanged"/>
     <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Content="⇄   Маршрутизация" Tag="routes" Checked="NavigationChanged"/>
     <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Content="⚙   Настройки" Tag="settings" Checked="NavigationChanged"/>
     <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Content="≡   Журнал" Tag="logs" Checked="NavigationChanged"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,16,22"><TextBlock Text="WINDOWS  ·  X64" FontSize="10" Foreground="#636A59" Margin="0,10,0,4"/><TextBlock Text="Ваш маршрут. Ваш выбор." FontSize="10" Foreground="#7F8773"/></StackPanel><Grid/>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,25,28,22">
    <Grid x:Name="Dashboard"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,22"><TextBlock Text="Подписки" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Выберите сервер в любой из ваших подписок" Foreground="#808873" FontSize="12" Margin="0,7,0,0"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Поиск по стране, названию или протоколу" Margin="0" Padding="12"/><TextBlock Text="Поиск по стране или протоколу…" Margin="13,0" VerticalAlignment="Center" Foreground="#7F8873" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <StackPanel Grid.Row="2"><Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><Button Content="＋  Подписка" Style="{StaticResource AccentButton}" Click="ShowSubscriptionClick" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Вставить" Click="PasteClick" Margin="0,0,8,0"/><Button Grid.Column="2" Content="↥" ToolTip="Импорт из файла" Click="ImportClick" Margin="0" Padding="0"/></Grid><Border x:Name="SubscriptionPanel" Visibility="Collapsed" Background="#151811" CornerRadius="12" Padding="16" Margin="0,0,0,14"><StackPanel><TextBlock Text="Новая подписка" FontSize="16"/><TextBox x:Name="SubscriptionBox" ToolTip="HTTPS-ссылка провайдера"/><Button Content="Добавить подписку" Click="UpdateClick" Style="{StaticResource AccentButton}"/></StackPanel></Border></StackPanel>
      <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer x:Name="SubscriptionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="GroupsList"><ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="#141611" BorderBrush="#25291F" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Expanded="GroupExpansionChanged" Collapsed="GroupExpansionChanged" HorizontalContentAlignment="Stretch" Foreground="#E9EBE3">
            <Expander.Header><StackPanel Margin="4,4,100,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdateText}" Foreground="#858E78" FontSize="10" Margin="0,5,0,0"/></StackPanel></Expander.Header>
            <ListBox ItemsSource="{Binding Servers}" Loaded="GroupListLoaded" PreviewMouseWheel="ServerListMouseWheel" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ItemTemplate="{StaticResource ServerTemplate}" ItemContainerStyle="{StaticResource ServerItem}" SelectionChanged="ServerSelectionChanged" MouseDoubleClick="ServerDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
           </Expander>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
            <Button Content="↻" ToolTip="Обновить подписку" Tag="{Binding}" Click="UpdateClick" Padding="8,5" Margin="2,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="◴" ToolTip="Проверить серверы подписки" Tag="{Binding}" Click="PingAllClick" Padding="8,5" Margin="2,0"/>
            <Button Content="×" ToolTip="Удалить подписку" Tag="{Binding}" Click="DeleteSubscriptionClick" Padding="8,5" Margin="2,0"/>
           </StackPanel>
           <StackPanel Grid.Row="1" Margin="4,10,4,0"><ProgressBar Value="{Binding TrafficPercent, Mode=OneWay}" Maximum="100" Height="3" Foreground="#7C9137" Background="#272D20" BorderThickness="0"/><Grid Margin="0,7,0,0"><TextBlock Text="{Binding TrafficText}" FontSize="10" Foreground="#919B82"/><TextBlock Text="{Binding ExpiryText}" FontSize="10" Foreground="#919B82" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Announcement}" Foreground="#AEBB90" TextWrapping="Wrap" FontSize="11"/></StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
       <TextBlock Grid.Row="1" x:Name="ListHint" FontSize="10" Foreground="#768066" TextWrapping="Wrap" Margin="6,10,6,0"/>
      </Grid>
      <TextBlock Grid.Row="4" x:Name="PingText" Foreground="#9BA987" FontSize="11" TextWrapping="Wrap" Margin="4,14,0,0"/>
     </Grid>
     <Border Grid.Column="2" CornerRadius="20" BorderBrush="#262B1E" BorderThickness="1">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C2115"/><GradientStop Color="#11140F" Offset="0.6"/><GradientStop Color="#171C12" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1*"/><RowDefinition Height="Auto"/><RowDefinition Height="0.7*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0"><Border CornerRadius="6" BorderBrush="#60772A" BorderThickness="1" Background="#263115" Padding="12,5"><TextBlock Text="TUN" Foreground="#C2DF51" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="Защита приложений" Foreground="#8C987B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
       <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,22"><Ellipse Width="214" Height="214" Stroke="#303C20" StrokeThickness="1"/><Ellipse Width="176" Height="176" Stroke="#394528" StrokeThickness="1"/><Ellipse x:Name="ConnectionRing" Width="190" Height="190" Stroke="#C2DF51" StrokeThickness="3" StrokeDashArray="28 170" Visibility="Hidden" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"><Ellipse.RenderTransform><RotateTransform x:Name="ConnectionRotation"/></Ellipse.RenderTransform></Ellipse>
        <Button x:Name="ConnectButton" Width="146" Height="146" Margin="0" Padding="0" Click="PowerClick" ToolTip="Подключить выбранный сервер"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="PowerCircle" CornerRadius="80" Background="#202719" BorderBrush="#4D6030" BorderThickness="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerCircle" Property="Background" Value="#303D21"/><Setter TargetName="PowerCircle" Property="BorderBrush" Value="#C2DF51"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerCircle" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><TextBlock x:Name="PowerGlyph" Text="⏻" Foreground="#C2DF51" FontFamily="Segoe UI Symbol" FontSize="58" Margin="0,-6,0,0"/></Button>
       </Grid>
       <StackPanel Grid.Row="2"><TextBlock x:Name="StatusText" Text="Не подключено" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ActiveText" Text="Выберите сервер слева" FontSize="11" Foreground="#919C83" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
       <StackPanel Grid.Row="4"><TextBlock Text="ВЫБРАННЫЙ СЕРВЕР" Foreground="#798768" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="SelectedText" Text="Сервер не выбран" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,4"/><TextBlock x:Name="SelectedProtocol" Foreground="#C2DF51" FontSize="11" TextAlignment="Center" Margin="0,0,0,20"/>
        <Button Content="Проверить задержку" Click="PingClick" Style="{StaticResource AccentButton}" Margin="0,0,0,8"/><Button Content="Проверить интернет через VPN" Click="ProbeClick" FontSize="11" Margin="0,0,0,0"/>
        <TextBlock Text="Подключение к выбранному серверу" Foreground="#768268" FontSize="10" TextAlignment="Center" Margin="0,15,0,3"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="RoutingPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Маршрутизация" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,22"/><Border Grid.Row="1" Background="#151811" CornerRadius="16" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel><TextBlock Text="Правила приложений" FontSize="19" /><ComboBox x:Name="ModeBox" SelectedIndex="0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ComboBoxItem Content="Все приложения через VPN" /><ComboBoxItem Content="Через VPN" /><ComboBoxItem Content="Напрямую, в обход VPN" /></ComboBox><ListBox x:Name="AppList" ItemContainerStyle="{StaticResource AppRuleItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="150" Background="#141611" Foreground="#E6EDF5" BorderBrush="#303329" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><WrapPanel><Button Content="Из процессов" Click="ProcessesClick" /><Button Content="Выбрать .exe" Click="BrowseAppClick" /><Button Content="Удалить" Click="RemoveAppClick" /></WrapPanel><DockPanel><Button DockPanel.Dock="Right" Content="Добавить путь" Click="AddPathClick" /><TextBox x:Name="AppPathBox" ToolTip="Полный путь к исполняемому файлу" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /></DockPanel><TextBlock Text="Правила сайтов" FontSize="19" Margin="0,22,0,8" />
<ComboBox x:Name="SiteModeBox" SelectedIndex="0" SelectionChanged="RoutingModeChanged" ToolTip="Все сайты — без ограничений по списку. Через VPN — только сайты из списка, остальные напрямую. Напрямую — сайты из списка в обход VPN."><ComboBoxItem Content="Все сайты" /><ComboBoxItem Content="Через VPN" /><ComboBoxItem Content="Напрямую, в обход VPN" /></ComboBox><TextBox x:Name="VpnSitesBox" Visibility="Collapsed" AcceptsReturn="True" Height="78" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="Например: youtube.com, googlevideo.com. Можно вставить HTTP/HTTPS-ссылку." />
<TextBox x:Name="DirectSitesBox" Visibility="Collapsed" AcceptsReturn="True" Height="78" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="Например: example.com. По одному домену на строку или через запятую." />
<TextBlock Text="В режиме «Через VPN» только сайты из списка идут через VPN, остальные — напрямую. В режиме обхода сайты из списка идут напрямую. Списки режимов сохраняются раздельно. Домен включает все поддомены. Для видео добавьте также домены его CDN, например googlevideo.com. Из ссылок берётся только домен; отдельные страницы не различаются." Foreground="#92978A" TextWrapping="Wrap" Margin="0,5,0,12" />
<TextBlock Text="Правила GeoIP" FontSize="19" Margin="0,15,0,0" /><ComboBox x:Name="GeoModeBox" SelectedIndex="0" SelectionChanged="RoutingModeChanged" ToolTip="Все страны — без ограничений по GeoIP. Через VPN — только страны из списка, остальные напрямую. Напрямую — страны из списка в обход VPN."><ComboBoxItem Content="Все страны" /><ComboBoxItem Content="Через VPN" /><ComboBoxItem Content="Напрямую, в обход VPN" /></ComboBox><TextBox x:Name="CountriesBox" ToolTip="Коды стран через запятую: ru, by, kz. В режиме «Через VPN» пустой список направляет остальной трафик напрямую." xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><CheckBox x:Name="LanBox" Content="Локальная сеть в обход VPN" IsChecked="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><TextBlock Text="Приоритет: локальная сеть → сайты → приложения → GeoIP → VPN. «Все» не добавляет ограничений раздела. «Через VPN» направляет только список через VPN, остальной трафик — напрямую; пустой список направляет остальной трафик напрямую. Если браузер скрывает имя сайта через ECH и собственный DNS, правило может не распознаться. DNS обрабатывается клиентом отдельно." Foreground="#92978A" TextWrapping="Wrap" Margin="0,5" /><Button Content="Сохранить правила" Click="SaveClick" HorizontalAlignment="Left" /><TextBlock Text="Новые правила применяются при следующем подключении. Дочерние процессы с другим .exe добавляйте отдельно." Foreground="#92978A" TextWrapping="Wrap" /></StackPanel></ScrollViewer></Border></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Настройки" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,22"/>

     <Border Background="#151811" CornerRadius="16" Padding="22" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="Запуск и защита" FontSize="20" Margin="0,0,0,12"/>
      <CheckBox x:Name="StartupBox" Content="Запускать Aster VPN при входе в Windows"/>
      <TextBlock Text="Запуск свёрнутым в трей через планировщик Windows с правами администратора." Foreground="#92978A" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <CheckBox x:Name="AutoConnectBox" Content="Подключаться автоматически при запуске клиента"/>
      <TextBlock Text="Используется последний выбранный сервер. Работает и при обычном запуске, и при входе в Windows." Foreground="#92978A" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <CheckBox x:Name="KillSwitchBox" Content="Kill switch — блокировать интернет при обрыве VPN"/>
      <TextBlock Text="Включается при подключении. Блокировка IPv4/IPv6 сохраняется при восстановлении и аварийном закрытии клиента. Ручное отключение VPN, штатный выход или выключение Kill switch снимают блокировку. После сбоя запустите клиент повторно. Прямые правила работают через ядро; доступ к LAN зависит от настройки маршрутизации. Служебный трафик клиента, ядер и DHCP разрешён." Foreground="#92978A" TextWrapping="Wrap"/>
      <Button Content="Сохранить настройки" Click="SaveClick" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel></Border>
     <Border Background="#151811" CornerRadius="16" Padding="22"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><TextBlock Text="HWID устройства" FontSize="20"/><TextBox x:Name="HwidBox" IsReadOnly="True" ToolTip="Ctrl+C — скопировать HWID"/><TextBlock Text="Передаётся панели при обновлении подписки. Постоянный для этой установки Windows." TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#92978A"/><TextBlock Text="Контроль и восстановление" FontSize="20" Margin="0,0,0,12" /><CheckBox x:Name="ReconnectBox" Content="Автоматически восстанавливать соединение" IsChecked="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><TextBlock Text="Проверка каждые 30 секунд. Перезапуск после 3 неудачных проверок или смены сети. Восстановление продолжается с увеличением паузы." Foreground="#92978A" TextWrapping="Wrap" /><CheckBox x:Name="AutoUpdateBox" Content="Обновлять подписки с интервалом, указанным провайдером" IsChecked="True" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><TextBlock Text="HTTPS-адрес для проверки интернета через VPN" Margin="0,20,0,0" /><TextBox x:Name="ProbeBox" Text="https://www.gstatic.com/generate_204" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" /><WrapPanel><Button Content="Проверить через VPN" Click="ProbeClick" /><Button Content="Сохранить настройки" Click="SaveClick" /></WrapPanel><TextBlock Text="Крестик скрывает окно в трей, VPN продолжает работать. Для завершения выберите «Выход» в меню значка. Без Kill switch при остановке ядра трафик может пойти напрямую." Foreground="#92978A" TextWrapping="Wrap" Margin="0,22" /><TextBlock x:Name="ProductVersionText" Foreground="#C2DF51" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Журнал соединения" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>

